<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
        Plugin discovery queries receivers of the Locale FIRE_SETTING broadcast
        (see PluginRepositoryImpl). Declared here precisely so the query is
        explicit on Android 11+ without relying on QUERY_ALL_PACKAGES alone.
    -->
    <queries>
        <intent>
            <action android:name="com.twofortyfouram.locale.intent.action.FIRE_SETTING" />
        </intent>
    </queries>
</manifest>
