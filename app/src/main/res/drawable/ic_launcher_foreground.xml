    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- The flow line and its branch. -->
    <path
        android:fillColor="#00000000"
        android:pathData="M36.4,54 L71.6,54"
        android:strokeColor="#FFFFFFFF"
        android:strokeLineCap="round"
        android:strokeWidth="5" />
    <path
        android:fillColor="#00000000"
        android:pathData="M54,54 L54,41.9"
        android:strokeColor="#FFFFFFFF"
        android:strokeLineCap="round"
        android:strokeWidth="5" />

    <!-- The three nodes. -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M36.4,54m-5.5,0a5.5,5.5 0,1 1,11 0a5.5,5.5 0,1 1,-11 0" />
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M71.6,54m-5.5,0a5.5,5.5 0,1 1,11 0a5.5,5.5 0,1 1,-11 0" />
    <path
        android:fillColor="#FFFFFFFF"
