<?xml version="1.0" encoding="utf-8"?>
<!--
    Launcher foreground — Google 2026 recipe: white bold glyph on the vivid
    gradient. A rounded checkmark ("المهام المجدولة / Scheduled Tasks") with a
    small clock in the corner (scheduled + time). Language-neutral; works in
    LTR and RTL launchers. No aapt:attr gradients — solid white only, 100%
    launcher-safe.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Bold checkmark (single white path, rounded joins). -->
    <path
        android:pathData="M33,54L46,67L75,38"
        android:fillColor="#00000000"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="12"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />

    <!-- Small clock ring. -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="2.8"
        android:pathData="M80,80m-8,0a8,8 0 1 0 16,0a8,8 0 1 0 -16,0" />

    <!-- Clock hands. -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="2.6"
        android:strokeLineCap="round"
        android:pathData="M80,80L80,74.8" />
    <path
        android:fillColor="#00000000"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="2.6"
        android:strokeLineCap="round"
        android:pathData="M80,80L85.4,83.8" />
</vector>
