<?xml version="1.0" encoding="utf-8"?>
<!--
    Launcher foreground: the Google Tasks mark — a bold two-tone checkmark
    (indigo → violet, drawn as two solid segments so the gradient feel
    survives every launcher) — paired with a small clock in the corner, so
    the glyph reads "المهام المجدولة / Scheduled Tasks" (tasks + time).
    Language-neutral: the same mark works in LTR and RTL launchers.
    No aapt:attr gradients — only solid colors, 100% launcher-safe.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Bold checkmark, up-stroke (indigo). -->
    <path
        android:pathData="M35,56L47,68"
        android:fillColor="#00000000"
        android:strokeColor="#FF3D5AFE"
        android:strokeWidth="11"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />

    <!-- Bold checkmark, down-stroke (violet) — overlaps for a smooth join. -->
    <path
        android:pathData="M47,68L73,40"
        android:fillColor="#00000000"
        android:strokeColor="#FF8E4DFF"
        android:strokeWidth="11"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />

    <!-- Small clock: "scheduled" hint in the corner. -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#FF5B5CF6"
        android:strokeWidth="2.6"
        android:pathData="M79,78m-7.5,0a7.5,7.5 0 1 0 15,0a7.5,7.5 0 1 0 -15,0" />
    <path
        android:fillColor="#00000000"
        android:strokeColor="#FF5B5CF6"
        android:strokeWidth="2.4"
        android:strokeLineCap="round"
        android:pathData="M79,78L79,73.6" />
    <path
        android:fillColor="#00000000"
        android:strokeColor="#FF5B5CF6"
        android:strokeWidth="2.4"
        android:strokeLineCap="round"
        android:pathData="M79,78L83.6,81.2" />
</vector>
