# Copy to keystore/keystore.properties and fill in the real values.
# This example file IS committed; keystore.properties itself is gitignored.
storeFile=keystore/nexaflow-release.jks
storePassword=CHANGE_ME
keyAlias=nexaflow
keyPassword=CHANGE_ME
# Google Maps API key for the embedded map picker (com.google.android.geo.API_KEY).
# Optional — leave empty to render a setup hint instead of the map.
mapsApiKey=CHANGE_ME
