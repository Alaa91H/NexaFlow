<?xml version="1.0" encoding="utf-8"?>
<!--
    NexaFlow privileged-app permissions.

    To integrate NexaFlow as an authentic system component of a ROM:
      1. Build the app, sign it with the platform key.
      2. Install it under /system/priv-app/NexaFlow/ (or PRODUCT_PACKAGES).
      3. Copy this file into the ROM at: system/etc/permissions/privapp-permissions-nexaflow.xml

    This grants the privileged permissions below so NexaFlow can control the
    device without root and without user-granted runtime permissions.
-->
<permissions>
    <privapp-permissions package="com.nexaflow.app">
        <permission name="android.permission.WRITE_SECURE_SETTINGS" />
        <permission name="android.permission.WRITE_SETTINGS" />
        <permission name="android.permission.MODIFY_PHONE_STATE" />
        <permission name="android.permission.READ_LOGS" />
        <permission name="android.permission.PACKAGE_USAGE_STATS" />
        <permission name="android.permission.STATUS_BAR" />
        <permission name="android.permission.EXPAND_STATUS_BAR" />
        <permission name="android.permission.FORCE_STOP_PACKAGES" />
        <permission name="android.permission.KILL_BACKGROUND_PROCESSES" />
        <permission name="android.permission.SYSTEM_ALERT_WINDOW" />
        <permission name="android.permission.ACCESS_NOTIFICATION_POLICY" />
    </privapp-permissions>
</permissions>
