<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
        Required by SystemController.vibrate (new vibrate action); library
        lint validates this module against its own manifest, not the app's.
    -->
    <uses-permission android:name="android.permission.VIBRATE" />


    <!-- Reading the active subscription list is required to address the
         correct SIM when switching the preferred network mode on multi-SIM
         devices. READ_PHONE_STATE is a runtime permission the app requests
         as part of its phone-mode capability. -->
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />

    <!--
        Shizuku UserService: the Shizuku server forks a process from its own
        (root / shell uid), reflectively instantiates the class named in
        ShizukuShellBridge.bindUserService and uses the instance itself as the
        binder. It is NOT an Android platform service — it must not be
        declared here (a manifest <service> would only matter for a normal
        context bind, which the UserService lifecycle never performs), and
        the class extends IUserShellService.Stub directly.
    -->
</manifest>
