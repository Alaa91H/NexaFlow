<?xml version="1.0" encoding="utf-8"?>
<!--
  Notification small icon (white silhouette on transparent). Android renders
  notification small icons as an alpha mask tinted with the system accent, so
  the glyph is a single-colour path — the bold checkmark from the launcher
  identity (المهام المجدولة / Scheduled Tasks). A lone check reads clearly
  at the standard 24dp status-bar size.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <path
        android:fillColor="#00000000"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="3.4"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:pathData="M4.2,12.6L9.8,18.2L19.8,5.8" />
</vector>
