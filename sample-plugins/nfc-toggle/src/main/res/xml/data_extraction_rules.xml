<?xml version="1.0" encoding="utf-8"?>
<!--
    Android 12+ backup rules: the plugin holds no user data worth backing up
    (config lives in the host), so both cloud backup and device transfer are
    fully excluded — matching allowBackup="false" for older API levels.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
    </device-transfer>
</data-extraction-rules>
