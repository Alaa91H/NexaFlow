*.iml
.gradle
/local.properties
/.idea
.DS_Store
**/build
# The `**/build` rule above accidentally swallows buildSrc's source tree —
# its package directory is literally `com/nexaflow/build/`. Un-ignore it so
# the GitVersion plugin source stays tracked (a fresh checkout/CI depends on it).
!buildSrc/src/main/java/com/nexaflow/build/
/captures
.externalNativeBuild
.cxx
local.properties

# Local Freebuff app state
.freebuff/

# Local Freebuff preview tool (not part of the app)
preview/

# Kotlin daemon error logs
.kotlin/

# Release signing material — never commit keystores or credentials.
/keystore/*.jks
/keystore/*.keystore
/keystore/keystore.properties
__pycache__
