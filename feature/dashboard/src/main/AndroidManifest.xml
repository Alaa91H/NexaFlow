<?xml version="1.0" encoding="utf-8"?>
<!--
    Permission used by the dashboard's live connectivity status row
    (readConnectivityStatus). Merged into the app manifest, which already
    declares it; declared here so lint can validate the call in this module.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

</manifest>
