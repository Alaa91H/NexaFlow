    <string name="permission_camera_body">Die Taschenlampen-Aktion nutzt den Kamerablitz. Es wird nie ein Foto aufgenommen.</string>
    <string name="permission_notifications_title">Benachrichtigungen</string>
    <string name="permission_notifications_body">NexaFlow sendet dir eine Benachrichtigung, wenn eine Aufgabe ausgeführt wird, damit du weißt, was passiert ist.</string>
    <string name="permission_bluetooth_title">Geräte in der Nähe</string>
    <string name="permission_bluetooth_body">So erkennen Aufgaben, wenn sich dein gewähltes Bluetooth-Gerät verbindet oder trennt.</string>
    <string name="permission_calendar_title">Kalenderzugriff</string>
    <string name="permission_calendar_body">So können Aufgaben rund um Kalenderereignisse ausgeführt werden, z. B. vor Beginn eines Meetings.</string>
