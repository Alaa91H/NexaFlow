    <string name="permission_generic_body">Diese Berechtigung lässt die gewählte Aufgabe wie erwartet funktionieren.</string>
    <string name="special_write_settings_title">Systemeinstellungen ändern</string>
    <string name="special_write_settings_body">NexaFlow benötigt dies, um Helligkeit, Bildschirm-Timeout, Rotation und mehr während deiner Aufgaben anzupassen.</string>
