    <string name="permission_location_title">Acceso a la ubicación</string>
    <string name="permission_location_body">NexaFlow usa tu ubicación para ejecutar tareas al entrar o salir de un lugar.</string>
    <string name="permission_sms_title">Leer mensajes</string>
    <string name="permission_sms_body">Permite que las tareas reaccionen cuando llega un mensaje y respondan automáticamente.</string>
    <string name="permission_send_sms_title">Enviar mensajes</string>
    <string name="permission_send_sms_body">Permite que una tarea envíe un mensaje como una de sus acciones.</string>
    <string name="permission_camera_title">Acceso a la cámara</string>
    <string name="permission_camera_body">La acción de linterna usa el flash de la cámara. Nunca se toma una foto.</string>
    <string name="permission_notifications_title">Notificaciones</string>
    <string name="permission_notifications_body">NexaFlow te envía una notificación cuando se ejecuta una tarea, para que sepas qué ocurrió.</string>
    <string name="permission_bluetooth_title">Dispositivos cercanos</string>
    <string name="permission_bluetooth_body">Permite que las tareas detecten cuándo tu dispositivo Bluetooth elegido se conecta o desconecta.</string>
    <string name="permission_calendar_title">Acceso al calendario</string>
    <string name="permission_calendar_body">Permite que las tareas se ejecuten alrededor de eventos del calendario, como antes de una reunión.</string>
    <string name="permission_local_network_title">Acceso a la red local</string>
    <string name="permission_local_network_body">Permite que las tareas HTTP alcancen dispositivos de tu red doméstica, como enchufes inteligentes o hubs multimedia.</string>
    <string name="permission_generic_title">Permiso necesario</string>
    <string name="permission_generic_body">Este permiso permite que la tarea elegida funcione como se espera.</string>
    <string name="special_write_settings_title">Modificar ajustes del sistema</string>
    <string name="special_write_settings_body">NexaFlow lo necesita para ajustar brillo, tiempo de pantalla, rotación y más mientras se ejecutan tus tareas.</string>
    <string name="special_dnd_title">Acceso a No molestar</string>
    <string name="special_dnd_body">Permite que tus tareas silencien notificaciones o restauren el sonido automáticamente.</string>
    <string name="special_notification_access_title">Acceso a notificaciones</string>
    <string name="special_notification_access_body">Permite que las tareas lean notificaciones de apps, reaccionen o las bloqueen por ti.</string>
    <string name="special_accessibility_title">Servicio de accesibilidad</string>
    <string name="special_accessibility_body">NexaFlow lo usa para detectar cuándo se abren las apps y cerrarlas automáticamente.</string>
    <string name="special_shizuku_title">Shizuku</string>
    <string name="special_shizuku_body">Permite que tareas avanzadas controlen ajustes del sistema sin root. Inicia Shizuku y concede acceso una vez.</string>
    <string name="special_root_title">Acceso root</string>
    <string name="special_root_body">Permite que las tareas ejecuten comandos que necesitan root (su). Concede la solicitud de superusuario cuando aparezca.</string>
    <string name="special_elevated_title">Privilegios elevados</string>
    <string name="special_elevated_body">Esta acción necesita root, Shizuku o privilegios de app del sistema para controlar ajustes protegidos.</string>
    <string name="special_bluetooth_title">Bluetooth</string>
    <string name="special_bluetooth_body">NexaFlow necesita Bluetooth activado para detectar dispositivos emparejados y ejecutar tareas cuando se conectan.</string>

