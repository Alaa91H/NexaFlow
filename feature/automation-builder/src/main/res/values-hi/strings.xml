    <string name="permission_location_title">स्थान पहुंच</string>
    <string name="permission_location_body">किसी स्थान में प्रवेश या निकास पर कार्य चलाने के लिए NexaFlow आपके स्थान का उपयोग करता है।</string>
    <string name="permission_sms_title">संदेश पढ़ें</string>
    <string name="permission_sms_body">इससे संदेश आने पर कार्य प्रतिक्रिया कर सकते हैं और स्वतः उत्तर दे सकते हैं।</string>
    <string name="permission_send_sms_title">संदेश भेजें</string>
    <string name="permission_send_sms_body">इससे कोई कार्य अपनी क्रियाओं में से एक के रूप में संदेश भेज सकता है।</string>
    <string name="permission_camera_title">कैमरा पहुंच</string>
    <string name="permission_camera_body">टॉर्च क्रिया कैमरा फ्लैश का उपयोग करती है। कोई तस्वीर नहीं ली जाती।</string>
    <string name="permission_notifications_title">सूचनाएँ</string>
    <string name="permission_notifications_body">कोई कार्य चलने पर NexaFlow आपको सूचना भेजता है, ताकि आप जान सकें कि क्या हुआ।</string>
    <string name="permission_bluetooth_title">आस-पास के डिवाइस</string>
    <string name="permission_bluetooth_body">इससे कार्य यह पता लगा सकते हैं कि आपका चुना हुआ ब्लूटूथ डिवाइस कब जुड़ा या अलग हुआ।</string>
    <string name="permission_calendar_title">कैलेंडर पहुंच</string>
    <string name="permission_calendar_body">इससे कार्य कैलेंडर ईवेंट के आसपास चल सकते हैं, जैसे बैठक शुरू होने से पहले।</string>
    <string name="permission_local_network_title">स्थानीय नेटवर्क एक्सेस</string>
    <string name="permission_local_network_body">HTTP कार्यों को आपके होम नेटवर्क के उपकरणों तक पहुँचने देता है, जैसे स्मार्ट प्लग या मीडिया हब।</string>
    <string name="permission_generic_title">अनुमति आवश्यक</string>
    <string name="permission_generic_body">यह अनुमति चुने गए कार्य को अपेक्षित रूप से काम करने देती है।</string>
    <string name="special_write_settings_title">सिस्टम सेटिंग्स बदलें</string>
    <string name="special_write_settings_body">आपके कार्य चलते समय चमक, स्क्रीन टाइमआउट, रोटेशन और अधिक समायोजित करने के लिए NexaFlow को इसकी आवश्यकता है।</string>
    <string name="special_dnd_title">डू नॉट डिस्टर्ब पहुंच</string>
    <string name="special_dnd_body">आपके कार्यों को सूचनाएँ म्यूट करने या ध्वनि स्वचालित रूप से बहाल करने देता है।</string>
    <string name="special_notification_access_title">सूचना पहुंच</string>
    <string name="special_notification_access_body">कार्यों को ऐप सूचनाएँ पढ़ने, उन पर प्रतिक्रिया देने या उन्हें ब्लॉक करने देता है।</string>
    <string name="special_accessibility_title">एक्सेसिबिलिटी सेवा</string>
    <string name="special_accessibility_body">NexaFlow इसका उपयोग ऐप खुलने का पता लगाने और उन्हें स्वचालित रूप से बंद करने के लिए करता है।</string>
    <string name="special_shizuku_title">शिज़ुकु</string>
    <string name="special_shizuku_body">उन्नत कार्यों को बिना रूट के सिस्टम सेटिंग्स नियंत्रित करने देता है। शिज़ुकु शुरू करें और एक बार पहुंच दें।</string>
    <string name="special_root_title">रूट पहुंच</string>
    <string name="special_root_body">कार्यों को ऐसे कमांड चलाने देता है जिन्हें रूट (su) चाहिए। दिखने पर सुपरयूज़र अनुरोध दें।</string>
    <string name="special_elevated_title">उन्नत विशेषाधिकार</string>
    <string name="special_elevated_body">संरक्षित सेटिंग्स नियंत्रित करने के लिए इस क्रिया को रूट, शिज़ुकु या सिस्टम-ऐप विशेषाधिकार चाहिए।</string>
    <string name="special_bluetooth_title">ब्लूटूथ</string>
    <string name="special_bluetooth_body">जोड़े गए डिवाइस का पता लगाने और उनके कनेक्ट होने पर कार्य चलाने के लिए NexaFlow को ब्लूटूथ चालू चाहिए।</string>


